# Firebase web config.
# Estas variables son publicas por diseno: se pueden exponer al cliente.
# Sin ellas, el catalogo publico usa datos locales de ejemplo (seed) y /admin
# queda deshabilitado.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend serverless / Vercel Functions.
# No usar prefijo VITE_: estos valores son privados y solo deben existir en el
# entorno server-side.
FIREBASE_SERVICE_ACCOUNT=

# WhatsApp Cloud API / Meta Graph API.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
