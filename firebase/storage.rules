rules_version = '2';

// Portadas de libros: lectura pública, escritura solo del administrador,
// limitada a imágenes de máximo 5 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /portadas/{archivo} {
      allow read: if true;
      // Crear/actualizar: solo el admin, imágenes de máximo 5 MB.
      allow create, update: if request.auth != null
        && request.auth.uid == 'UID_ADMIN'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // Borrar: solo el admin (request.resource es null en deletes).
      allow delete: if request.auth != null
        && request.auth.uid == 'UID_ADMIN';
    }
  }
}
