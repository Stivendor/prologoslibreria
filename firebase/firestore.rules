rules_version = '2';

// Reglas de seguridad de Firestore para Prólogos Librería.
// Catálogo: lectura pública, escritura solo desde el backend (Admin SDK / consola).
// Pedidos: el cliente puede crear un pedido; leer/editar queda restringido al backend.
service cloud.firestore {
  match /databases/{database}/documents {

    match /categorias/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /libros/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /pedidos/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
